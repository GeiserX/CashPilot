#!/bin/sh
# Prints the exit IP and country this network namespace reaches the internet
# from, as one line of JSON: {"ip":"203.0.113.7","country":"ES"}.
# Exit status 1 when no IP-echo endpoint answers.
#
# CP_DEADLINE (set by cp-tunnel): the epoch second by which the worker reads
# the answer. Until then each request gets its cap or the time left, whichever
# is less, and at least 1 s; the country, which only labels the answer, is
# skipped with under 2 s left. The worker waits 5 s past the deadline, so those
# 5 s count too: 1 s per request, no country. Only after them does nobody
# wait, and every request gets its full time again.
set -u

cap() {
    left=$((${CP_DEADLINE:-0} - $(date +%s)))
    if [ -z "${CP_DEADLINE:-}" ] || [ "$left" -lt -5 ] || [ "$left" -ge "$1" ]; then
        echo "$1"
    elif [ "$left" -lt 1 ]; then echo 1; else echo "$left"; fi
}

# An address, or nothing: an error page cut down to its hex letters ("e") is
# no exit, and the next endpoint gets its turn.
is_ip() {
    case "$1" in
    *:*:*)
        # Hex groups of up to 4 between colons, at most one "::" and 8 groups
        # (7 colons when nothing is compressed); ":::" and a lone edge colon are not.
        case "$1" in *[!0-9a-fA-F:]* | *:::* | *::*::* | :[!:]* | *[!:]:) return 1 ;; esac
        colons=$(printf '%s' "$1" | tr -cd ':' | wc -c)
        case "$1" in
        *::*) [ "$colons" -le 7 ] || return 1 ;;
        *) [ "$colons" -eq 7 ] || return 1 ;;
        esac
        old_ifs=$IFS
        IFS=:
        # shellcheck disable=SC2086 # split on the colons
        set -- $1
        IFS=$old_ifs
        for group in "$@"; do
            [ "${#group}" -le 4 ] || return 1
        done
        ;;
    *.*.*.*)
        case "$1" in *[!0-9.]* | *..* | .* | *.) return 1 ;; esac
        old_ifs=$IFS
        IFS=.
        # shellcheck disable=SC2086 # split on the dots
        set -- $1
        IFS=$old_ifs
        [ "$#" -eq 4 ] || return 1
        for octet in "$@"; do
            [ "${#octet}" -le 3 ] && [ "$octet" -le 255 ] || return 1
        done
        ;;
    *) return 1 ;;
    esac
}

ip=""
for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip=$(curl -fsS --max-time "$(cap 8)" "$url" 2>/dev/null | tr -cd '0-9a-fA-F.:' | cut -c1-45)
    is_ip "$ip" && break
    ip=""
done
[ -n "$ip" ] || exit 1

country=""
t=$(cap 8)
if [ "$t" -ge 2 ]; then
    country=$(curl -fsS --max-time "$t" "https://ipinfo.io/$ip/country" 2>/dev/null | tr -cd 'A-Z' | cut -c1-2)
fi
printf '{"ip":"%s","country":"%s"}\n' "$ip" "$country"
